# "mock" = canned demo data (no credits spent). "live" = real Redpine MCP calls.
TABILENS_MODE=mock

PORT=8787

# Redpine MCP endpoint + key (from the hackathon dashboard — do not commit the real key)
REDPINE_MCP_URL=
REDPINE_API_KEY=

# Safety rail for the demo: searches costing more than this (USD) are NOT auto-confirmed.
MAX_AUTO_CONFIRM_USD=0.50

# Tool names — verify with `find-tools` / `inspect-tool` at the venue, the catalog is per-account.
REDPINE_MAGAZINE_SEARCH_TOOL=search-addix-magazines
REDPINE_AUDIO_SEARCH_TOOL=search-chronicle-news-connect
TOBU_FIND_STOP_TOOL=tobu--find_stop
TOBU_RAIL_DEPARTURES_TOOL=tobu--rail_departures
TOBU_STATION_BUS_LINKS_TOOL=tobu--station_bus_links
